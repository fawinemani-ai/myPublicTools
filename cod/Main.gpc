//============================================================================
// PS5 WARZONE PRO SCRIPT - "PLUG & PLAY" ULTIMATE EDITION
// Version: 8.0 - 125Hz VM, 8-STEP DIAMOND AA, 3-STAGE RECOIL & OMNIMOVEMENT
//============================================================================
//---------------------------/ PS5 CONTROLS ---------------------------------
define FIRE = 4; // R2
define JUMP_R3 = 5; // R3 (Sprungtaste bei Stick & Move)
define ADS = 7; // L2
define L3_BTN = 8; // L3 (Taktik-Rutschen + Auto Sprint/Breath)
define RX = 9; // Rechter Stick X
define RY = 10; // Rechter Stick Y
define LX = 11; // Linker Stick X (Strafe)
define LY = 12; // Linker Stick Y (Laufen)
define UP = 13; // D-Pad Hoch (Auto-Ping)
define DOWN = 14; // D-Pad Runter (Profil-Sync falls vertauscht)
define LEFT = 15; // D-Pad Links
define RIGHT = 16; // D-Pad Rechts
define SW_WEAPON = 17; // Dreieck (Waffenwechsel & Easy Plate)
define CIRCLE = 18; // Kreis (Taktik-Rutschen / Drop-Shot)
define CROSS = 19; // X (Nahkampf bei Stick & Move)
define RELOAD = 20; // Viereck (Nachladen)

//---------------------------/ FESTE PROFI-WERTE ----------------------------
// --- PROFIL 1: MP (MASCHINENPISTOLE - PRIMÄR / GRÜN) ---
define SMG_RECOIL_V = 13; // Basis-Rückstoß für MPs (Mittelphase)
define SMG_KICK_BOOST = 4; // Stufe 1: Extra-Ausgleich erste 250ms (First-Shot-Kick)
define SMG_SUSTAIN_DAMP = 2; // Stufe 3: Entlastung ab 850ms Dauerfeuer (verhindert Runterziehen)
define SMG_RECOIL_H = 0; // Optionaler Horizontal-Ausgleich (-5 bis +5 falls Waffe zieht)
define SMG_AA_ADS = 13; // Weicher Magnetismus beim Zielen
define SMG_AA_FIRE = 16; // Starker Lock-On im Nahkampf
define SMG_STRAFE_TIME = 155; // Schnelles Links/Rechts im Nahkampf

// --- PROFIL 2: STURMGEWEHR (AR - SEKUNDÄR / BLAU) ---
define AR_RECOIL_V = 19; // Basis-Rückstoß für Distanz-Schüsse (Mittelphase)
define AR_KICK_BOOST = 5; // Stufe 1: Extra-Ausgleich erste 280ms (First-Shot-Kick)
define AR_SUSTAIN_DAMP = 3; // Stufe 3: Stabilisierung ab 950ms Dauerfeuer
define AR_RECOIL_H = 0; // Optionaler Horizontal-Ausgleich
define AR_AA_ADS = 10; // Ruhiges Fadenkreuz auf weite Distanz
define AR_AA_FIRE = 13; // Präziser Halt beim Dauerfeuer
define AR_STRAFE_TIME = 195; // Ruhigeres Strafe für bessere Präzision

// --- SPEZIAL- & KOMFORT-WERTE ---
define HIPFIRE_AA = 18; // Maximaler Aim-Assist beim Hüftfeuer (nur R2)
define STRAFE_STRENGTH = 75; // Optimale Strafe-Stärke
define AA_SPEED = 16; // Optimiert für 8ms VM-Loop (flüssige 125Hz Rotation)
define PING_COOLDOWN = 2500; // 2,5 Sek. Pause zwischen Auto-Pings
define DEADZONE_MIN = 5; // Filtert leichten Stick-Drift im Ruhezustand

//---------------------------/ LED FARBEN -----------------------------------
define LED_OFF = 0;
define LED_GREEN = 1;
define LED_BLUE = 2;
define LED_PINK = 3;
define LED_RED = 4;
define LED_SKYBLUE = 5;
define LED_YELLOW = 6;
define LED_WHITE = 7;

data(0, 0, 0, 0, 0, 0, 2, 0, 2, 0, 0, 0, 0, 0, 0, 2,
     0, 2, 0, 0, 2, 0, 2, 0, 0, 2, 2, 0, 2, 2, 2, 2);

//---------------------------/ VARIABLES ------------------------------------
int is_ar_profile = FALSE; // FALSE = MP (Grün), TRUE = Sturmgewehr (Blau)
int cur_recoil_v = 13;
int cur_recoil_h = 0;
int cur_aa_size = 13;
int cur_aa_diag = 9;
int cur_strafe_t = 155;
int dynamic_recoil_v = 0;
int current_led = -1;
int target_led = 0;
int rumble_cnt = 0;
int scj_lock = FALSE;
int prone_active = FALSE;
int ping_timer = 0;
int reload_timer = 0;
int plate_timer = 0;
int l3_phys = FALSE;
int circle_phys = FALSE;
int slide_pressed = FALSE;

//---------------------------/ MAIN BLOCK -----------------------------------
main {
	//====================================================================
	// 0. 125Hz DUALSENSE OVERCLOCK (8ms Reaktionszeit statt 10ms)
	//====================================================================
	vm_tctrl(-2);

	//====================================================================
	// 1. ZERO-STICK-DRIFT FILTER (Verhindert Zittern im Ruhezustand)
	//====================================================================
	if (!get_val(ADS) && !get_val(FIRE)) {
		if (abs(get_val(RX)) < DEADZONE_MIN) {
			set_val(RX, 0);
		}

		if (abs(get_val(RY)) < DEADZONE_MIN) {
			set_val(RY, 0);
		}

		if (abs(get_val(LX)) < DEADZONE_MIN) {
			set_val(LX, 0);
		}

		if (abs(get_val(LY)) < DEADZONE_MIN) {
			set_val(LY, 0);
		}
	}

	//====================================================================
	// 2. L3 BUTTON = KREIS BUTTON & OMNIMOVEMENT SLIDE-ONLY SCHUTZ
	//====================================================================
	l3_phys = get_val(L3_BTN) > 0;
	circle_phys = get_val(CIRCLE) > 0;
	slide_pressed = event_press(L3_BTN) || event_press(CIRCLE);

	// L3 löst KREIS aus (Beide Tasten identisch für Rutschen / Ducken / Hinlegen)
	if (l3_phys) {
		set_val(CIRCLE, 100);
		set_val(L3_BTN, 0);
	}

	// Slide-Only-Schutz: Verhindert beim Laufen (auch schräg im Omnimovement)
	// versehentlichen Hechtsprung (Dive), erlaubt aber Hinlegen im Stehen
	if ((l3_phys || circle_phys) && (get_val(LY) < -55 || abs(get_val(LX)) > 65) && !get_val(ADS) && !get_val(FIRE)) {
		if (get_ptime(L3_BTN) > 75 || get_ptime(CIRCLE) > 75) {
			set_val(CIRCLE, 0);
		}
	}

	//====================================================================
	// 3. AUTOMATISCHER WAFFEN-WECHSEL & EASY PLATE (DREIECK)
	//====================================================================
	// A) Kurzes Tippen auf Dreieck (< 250ms) = Waffenwechsel (MP <-> Sturmgewehr)
	if (event_release(SW_WEAPON) && get_ptime(SW_WEAPON) < 250 && plate_timer <= 0) {
		is_ar_profile = !is_ar_profile;
		rumble_cnt = 1;
	}

	// B) Dreieck kurz halten (ab 350ms) = Easy Plate startet (legt alle 3 Platten an)
	if (get_val(SW_WEAPON) && get_ptime(SW_WEAPON) >= 350 && plate_timer <= 0 && !get_val(ADS) && !get_val(FIRE)) {
		plate_timer = 4500; // 4,5 Sek. automatisch Platten nachschieben
		rumble_cnt = 1;
	}

	// Easy Plate aktiv: Hält Dreieck automatisch, bricht bei Kampf/Aktion in 0ms ab!
	if (plate_timer > 0) {
		if (get_val(ADS) || get_val(FIRE) || slide_pressed || event_press(RELOAD) || event_press(JUMP_R3)) {
			plate_timer = 0; // Sofortiger Abbruch für volle Kampfbereitschaft
		}
		else {
			plate_timer = plate_timer - get_rtime();
			set_val(SW_WEAPON, 100);
		}
	}

	// Manuelle Profil-Korrektur: Kurz D-Pad RUNTER drücken
	if (event_press(DOWN) && !get_val(ADS) && !get_val(FIRE)) {
		is_ar_profile = !is_ar_profile;
		rumble_cnt = 1;
	}

	//====================================================================
	// 4. DYNAMISCHE PROFIL- & 3-STUFEN PROGRESSIVE RECOIL-BERECHNUNG
	//====================================================================
	if (!is_ar_profile) {
		// --- MP-MODUS (PRIMÄR) ---
		cur_recoil_v = SMG_RECOIL_V;
		cur_recoil_h = SMG_RECOIL_H;

		if (get_val(FIRE)) {
			if (get_ptime(FIRE) < 250) {
				cur_recoil_v = SMG_RECOIL_V + SMG_KICK_BOOST; // Stufe 1: First-Shot-Kick
			}
			else if (get_ptime(FIRE) > 850) {
				cur_recoil_v = SMG_RECOIL_V - SMG_SUSTAIN_DAMP; // Stufe 3: Dauerfeuer-Glättung
			}
		}

		cur_strafe_t = SMG_STRAFE_TIME;

		if (get_val(ADS) && get_val(FIRE)) {
			cur_aa_size = SMG_AA_FIRE;
		}
		else if (!get_val(ADS) && get_val(FIRE)) {
			cur_aa_size = HIPFIRE_AA;
		}
		else {
			cur_aa_size = SMG_AA_ADS;
		}
	}
	else {
		// --- STURMGEWEHR-MODUS (SEKUNDÄR) ---
		cur_recoil_v = AR_RECOIL_V;
		cur_recoil_h = AR_RECOIL_H;

		if (get_val(FIRE)) {
			if (get_ptime(FIRE) < 280) {
				cur_recoil_v = AR_RECOIL_V + AR_KICK_BOOST; // Stufe 1: First-Shot-Kick
			}
			else if (get_ptime(FIRE) > 950) {
				cur_recoil_v = AR_RECOIL_V - AR_SUSTAIN_DAMP; // Stufe 3: Dauerfeuer-Glättung
			}
		}

		cur_strafe_t = AR_STRAFE_TIME;

		if (get_val(ADS) && get_val(FIRE)) {
			cur_aa_size = AR_AA_FIRE;
		}
		else if (!get_val(ADS) && get_val(FIRE)) {
			cur_aa_size = HIPFIRE_AA;
		}
		else {
			cur_aa_size = AR_AA_ADS;
		}
	}

	// Berechnet Diagonal-Vektor (ca. 70% für echten Kreis statt Quadrat)
	cur_aa_diag = (cur_aa_size * 7) / 10;
	PLAY_LEDS();

	//====================================================================
	// 5. HAIR TRIGGERS (Sofortiges Zielen & Schießen bei 1% Druck)
	//====================================================================
	if (get_val(ADS) > 0) {
		set_val(ADS, 100);
	}

	if (get_val(FIRE) > 0) {
		set_val(FIRE, 100);
	}

	//====================================================================
	// 6. FAST RELOAD CANCEL (Beim Schießen ODER Zielen im Notfall)
	//====================================================================
	if (event_press(RELOAD)) {
		reload_timer = 2100; // Überwacht den Nachladevorgang
	}

	if (reload_timer > 0) {
		reload_timer = reload_timer - get_rtime();

		// Wenn während des Nachladens geschossen wird -> Sofortiger YY-Cancel!
		if (event_press(FIRE)) {
			reload_timer = 0;
			combo_run(FAST_RELOAD_CANCEL);
		}
	}

	//====================================================================
	// 7. AUTO-PING GEGNER MARKIEREN (Beim Schießen im ADS)
	//====================================================================
	if (ping_timer > 0) {
		ping_timer = ping_timer - get_rtime();
	}

	if (get_val(ADS) && event_press(FIRE) && ping_timer <= 0) {
		combo_run(AUTO_ENEMY_PING);
		ping_timer = PING_COOLDOWN;
	}

	//====================================================================
	// 8. AUTO HOLD BREATH (Automatisch Luft anhalten für Visiere)
	//====================================================================
	if (get_val(ADS) && get_ptime(ADS) > 140 && abs(get_val(LY)) < 35 && !l3_phys && !circle_phys && !combo_running(SMART_DROP_SHOT)) {
		set_val(L3_BTN, 100);
	}

	//====================================================================
	// 9. AUTO-STRAFE (Mikro-Bewegung beim Schießen im ADS)
	//====================================================================
	if (get_val(ADS) && get_val(FIRE) && !combo_running(SMART_DROP_SHOT) && !prone_active) {
		if (abs(get_val(LX)) < 45 && abs(get_val(LY)) < 45) {
			combo_run(STRAFE_SHOT);
		}
		else {
			combo_stop(STRAFE_SHOT);
		}
	}
	else {
		combo_stop(STRAFE_SHOT);
	}

	//====================================================================
	// 10. 8-STEP DIAMOND AIM ASSIST (Inkl. Micro-Strafe Lock)
	//====================================================================
	if (get_val(ADS) || get_val(FIRE)) {
		combo_run(DIAMOND_ROTATIONAL_AA);
	}
	else {
		combo_stop(DIAMOND_ROTATIONAL_AA);
	}

	//====================================================================
	// 11. SMART DYNAMIC ANTI-RECOIL (Kein Kampf gegen deine Daumenbewegung)
	//====================================================================
	if (get_val(FIRE)) {
		// Reduziert Recoil-Stärke sanft, je stärker du selbst vertikal korrigierst
		dynamic_recoil_v = cur_recoil_v - (abs(get_val(RY)) / 6);

		if (dynamic_recoil_v < 0) {
			dynamic_recoil_v = 0;
		}

		if (get_val(ADS) && abs(get_val(RY)) < 85) {
			set_val(RY, clamp_val(get_val(RY) + dynamic_recoil_v, -100, 100));

			if (cur_recoil_h != 0 && abs(get_val(RX)) < 85) {
				set_val(RX, clamp_val(get_val(RX) + cur_recoil_h, -100, 100));
			}
		}
		else if (!get_val(ADS) && abs(get_val(RY)) < 75) {
			// Dezenter Ausgleich im Hüftfeuer (halbe Stärke)
			set_val(RY, clamp_val(get_val(RY) + (dynamic_recoil_v / 2), -100, 100));
		}
	}

	//====================================================================
	// 12. MOVEMENT: JUMP-SHOT, SMART DROP-SHOT (INKL. AUTO-UP) & SLIDE-CANCEL
	//====================================================================
	// A) Im Gunfight: R3 macht einen einzelnen, sofortigen Jump-Shot
	if (event_press(JUMP_R3) && (get_val(ADS) || get_val(FIRE))) {
		combo_stop(FAST_SLIDE_JUMP);
		scj_lock = FALSE;
		prone_active = FALSE;
		combo_run(INSTANT_COMBAT_JUMP);
	}

	// B) Smart Drop-Shot im Feuergefecht: L3 oder KREIS antippen legt dich sofort hin
	if (slide_pressed && (get_val(ADS) || get_val(FIRE))) {
		combo_stop(FAST_SLIDE_JUMP);
		combo_stop(STRAFE_SHOT);
		prone_active = TRUE;
		combo_run(SMART_DROP_SHOT);
	}

	// NEU: Auto-Stand-Up nach Drop-Shot! Wenn du aufhörst zu zielen/schießen
	// und nach vorne läufst, richtet dich das Script sofort wieder auf.
	if (prone_active && !get_val(ADS) && !get_val(FIRE) && !combo_running(SMART_DROP_SHOT)) {
		if (get_val(LY) < -75) {
			prone_active = FALSE;
			combo_run(QUICK_STAND_UP);
		}
		else if (slide_pressed || event_press(JUMP_R3)) {
			prone_active = FALSE;
		}
	}

	// C) Außerhalb des Kampfes beim Laufen: L3 oder KREIS macht Pro-Slide-Cancel
	if (!get_val(ADS) && !get_val(FIRE) && (get_val(LY) < -60 || abs(get_val(LX)) > 70)) {
		if (slide_pressed && !scj_lock) {
			scj_lock = TRUE;
			prone_active = FALSE;
			combo_stop(AUTO_TAC_SPRINT);
			combo_run(FAST_SLIDE_JUMP);
		}
	}

	if (scj_lock && !combo_running(FAST_SLIDE_JUMP)) {
		scj_lock = FALSE;
	}

	//====================================================================
	// 13. AUTOMATISCHER TAKTIK-SPRINT (Flüssiger Übergang)
	//====================================================================
	if (get_val(LY) < -75 && !get_val(ADS) && !get_val(FIRE) && !combo_running(FAST_SLIDE_JUMP) && !combo_running(QUICK_STAND_UP) && !l3_phys && !circle_phys) {
		combo_run(AUTO_TAC_SPRINT);
	}
	else {
		combo_stop(AUTO_TAC_SPRINT);
	}

	//====================================================================
	// 14. VIBRATIONS-FEEDBACK
	//====================================================================
	if (rumble_cnt > 0 && !combo_running(RUMBLE_FEEDBACK)) {
		combo_run(RUMBLE_FEEDBACK);
	}
}

//============================================================================
// COMBOS
//============================================================================
// Bricht Nachladen im Notfall per Doppel-Dreieck (YY) sofort ab
combo FAST_RELOAD_CANCEL {
	set_val(SW_WEAPON, 100);
	wait(32);
	set_val(SW_WEAPON, 0);
	wait(32);
	set_val(SW_WEAPON, 100);
	wait(32);
	set_val(SW_WEAPON, 0);
}

// Legt deinen Charakter im Gunfight durch kurzes Antippen von L3/Kreis sofort hin
combo SMART_DROP_SHOT {
	set_val(CIRCLE, 100);
	wait(650); // Optimiert: Schnellstes Hinlegen ohne Nachverzögerung
	set_val(CIRCLE, 0);
}

// Richtet den Spieler nach einem Drop-Shot automatisch auf, sobald er losrennt
combo QUICK_STAND_UP {
	set_val(JUMP_R3, 100);
	wait(40);
	set_val(JUMP_R3, 0);
	wait(40);
}

// Markiert Gegner automatisch per Doppel-Klick auf D-Pad Hoch
combo AUTO_ENEMY_PING {
	set_val(UP, 100);
	wait(32);
	set_val(UP, 0);
	wait(32);
	set_val(UP, 100);
	wait(32);
	set_val(UP, 0);
}

combo STRAFE_SHOT {
	set_val(LX, STRAFE_STRENGTH);
	wait(cur_strafe_t);
	set_val(LX, STRAFE_STRENGTH * -1);
	wait(cur_strafe_t);
}

// 8-Stufen Diamond Rotational Aim Assist (Kein eckiges Rucken mehr!)
combo DIAMOND_ROTATIONAL_AA {
	// Punkt 1: Unten
	set_val(RY, add_stick(RY, cur_aa_size));

	if (!combo_running(STRAFE_SHOT) && abs(get_val(LX)) < 20) {
		set_val(LX, 22);
	}

	wait(AA_SPEED);
	// Punkt 2: Unten-Rechts (Diagonal)
	set_val(RY, add_stick(RY, cur_aa_diag));
	set_val(RX, add_stick(RX, cur_aa_diag));
	wait(AA_SPEED);
	// Punkt 3: Rechts
	set_val(RX, add_stick(RX, cur_aa_size));
	wait(AA_SPEED);
	// Punkt 4: Oben-Rechts (Diagonal)
	set_val(RY, add_stick(RY, cur_aa_diag * -1));
	set_val(RX, add_stick(RX, cur_aa_diag));
	wait(AA_SPEED);
	// Punkt 5: Oben
	set_val(RY, add_stick(RY, cur_aa_size * -1));

	if (!combo_running(STRAFE_SHOT) && abs(get_val(LX)) < 20) {
		set_val(LX, -22);
	}

	wait(AA_SPEED);
	// Punkt 6: Oben-Links (Diagonal)
	set_val(RY, add_stick(RY, cur_aa_diag * -1));
	set_val(RX, add_stick(RX, cur_aa_diag * -1));
	wait(AA_SPEED);
	// Punkt 7: Links
	set_val(RX, add_stick(RX, cur_aa_size * -1));
	wait(AA_SPEED);
	// Punkt 8: Unten-Links (Diagonal)
	set_val(RY, add_stick(RY, cur_aa_diag));
	set_val(RX, add_stick(RX, cur_aa_diag * -1));
	wait(AA_SPEED);
}

combo INSTANT_COMBAT_JUMP {
	set_val(JUMP_R3, 100);
	wait(40);
	set_val(JUMP_R3, 0);
	wait(32);
	set_val(JUMP_R3, 100);
	wait(40);
	set_val(JUMP_R3, 0);
}

// Optimierter Slide-Cancel: Schnellerer Hitbox-Drop & nahtloser Sprint-Übergang
combo FAST_SLIDE_JUMP {
	set_val(CIRCLE, 100);
	wait(112); // Kürzerer Slide für maximalen Speed-Boost
	set_val(CIRCLE, 0);
	wait(56); // Ideales Fenster vor dem Cancel
	set_val(JUMP_R3, 100);
	wait(48); // Richtet Charakter ohne Sprung-Verzögerung auf
	set_val(JUMP_R3, 0);
	wait(24);
}

combo AUTO_TAC_SPRINT {
	set_val(L3_BTN, 100);
	wait(32);
	set_val(L3_BTN, 0);
	wait(48);
}

combo RUMBLE_FEEDBACK {
	set_rumble(RUMBLE_B, 85);
	wait(96);
	reset_rumble();
	wait(80);
	rumble_cnt--;
}

//============================================================================
// FUNCTIONS
//============================================================================
// Smart Stick-Blending: Dämpft den Aim-Assist-Input automatisch ab, sobald du
// den Stick stark bewegst (verhindert Widerstand beim schnellen Umdrehen/Tracking)
function add_stick(axis, offset) {
	if (abs(get_val(axis)) < 25) {
		return clamp_val(get_val(axis) + offset, -100, 100);
	}
	else if (abs(get_val(axis)) < 65) {
		return clamp_val(get_val(axis) + (offset / 2), -100, 100);
	}

	return get_val(axis);
}

function clamp_val(v, lo, hi) {
	if (v > hi) {
		return hi;
	}

	if (v < lo) {
		return lo;
	}

	return v;
}

function PLAY_LEDS() {
	if (plate_timer > 0) {
		target_led = LED_YELLOW; // Gelb = Easy Plate legt gerade Rüstungsplatten an
	}
	else if (get_val(ADS) && get_val(FIRE)) {
		target_led = LED_RED; // Rot = Im Feuergefecht (Lock-On + 3-Stufen Recoil)
	}
	else if (!is_ar_profile) {
		target_led = LED_GREEN; // Grün = MP-Profil aktiv (Primärwaffe)
	}
	else {
		target_led = LED_BLUE; // Blau = Sturmgewehr-Profil aktiv (Sekundärwaffe)
	}

	if (target_led != current_led) {
		color_led(target_led);
		current_led = target_led;
	}
}

function color_led(colour) {
	set_led(LED_1, duint8(colour * 4));
	set_led(LED_2, duint8((colour * 4) + 1));
	set_led(LED_3, duint8((colour * 4) + 2));
	set_led(LED_4, duint8((colour * 4) + 3));
}
