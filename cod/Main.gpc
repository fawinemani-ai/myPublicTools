// ============================================================================
// 🎮 WARZONE GPC PRO | REBIRTH QUADS EDITION V11.1 - MOVEMENT EDITION
// ============================================================================
// ----------------------------------------------------------------------------
// === KONFIGURATION ===
// ----------------------------------------------------------------------------
int current_weapon = 0;

// Anti-Recoil
int recoil_MP = 14;
int recoil_AR = 19;
int max_recoil_MP = 28;
int max_recoil_AR = 38;
int recoil_curve_rate = 6;

// Aim Assist
int aa_power = 14;
int aa_power_ar = 10;
int aa_delay = 10;
int ls_power = 12;
int hs_bias = 3;

// Movement
int strafe_power = 8;
int bhop_delay = 130;

// Feature-Flags
int crouch_on_ads_enabled = 0;
int dropshot_enabled = 1;
int strafe_aa_enabled = 1;
int hs_bias_enabled = 1;
int autosprint_enabled = 1;

// Zwischenspeicher
int active_recoil = 0;
int final_recoil = 0;
int recoil_start_value = 0;
int recoil_elapsed = 0;
int recoil_curve_bonus = 0;
int aa_power_current = 0;
int last_circle_time = 0;
int jump_state = 0;
int hs_ry = 0;

// ============================================================================
// INIT
// ============================================================================
init {
	update_feedback();
}

// ============================================================================
// MAIN LOOP
// ============================================================================
main {
	// 1. Hair Triggers
	if (get_val(PS4_L2) > 5) {
		set_val(PS4_L2, 100);
	}

	if (get_val(PS4_R2) > 5) {
		set_val(PS4_R2, 100);
	}

	// 2. Aim-Assist-Tuning
	if (get_val(PS4_L2)) {
		if (event_press(PS4_R3)) {
			aa_power = aa_power + 2;

			if (aa_power > 32) {
				aa_power = 32;
			}

			update_feedback();
		}

		if (event_press(PS4_L1)) {
			aa_power = aa_power - 2;

			if (aa_power < 4) {
				aa_power = 4;
			}

			update_feedback();
		}
	}

	// 3. Profil-Reset
	if (get_val(PS4_TOUCH) && event_press(PS4_TRIANGLE)) {
		current_weapon = 0;
		aa_power = 14;
		update_feedback();
	}

	// 4. Y-Y Spam
	if (get_val(PS4_RIGHT)) {
		combo_run(YY_Spam);
	}
	else if (combo_running(YY_Spam)) {
		combo_stop(YY_Spam);
	}

	// 5. Weapon Tracking
	if (event_release(PS4_TRIANGLE) && get_ptime(PS4_TRIANGLE) < 300 && !combo_running(YY_Spam)) {
		if (get_val(PS4_L2)) {
			current_weapon = 0;
		}
		else {
			current_weapon = !current_weapon;
		}

		update_feedback();
	}

	// 6. Anti-Recoil
	if (get_val(PS4_L2) && get_val(PS4_R2)) {
		recoil_start_value = (current_weapon == 0) ? recoil_MP : recoil_AR;
		recoil_elapsed = get_ptime(PS4_R2);
		recoil_curve_bonus = (recoil_elapsed * recoil_elapsed) / 3000;

		if (recoil_curve_bonus > 15) {
			recoil_curve_bonus = 15;
		}

		active_recoil = recoil_start_value + (recoil_elapsed / 100) * recoil_curve_rate + recoil_curve_bonus;

		if (current_weapon == 0 && active_recoil > max_recoil_MP) {
			active_recoil = max_recoil_MP;
		}

		if (current_weapon == 1 && active_recoil > max_recoil_AR) {
			active_recoil = max_recoil_AR;
		}

		if (abs(get_val(PS4_RY)) < 40 && abs(get_val(PS4_RX)) < 40) {
			final_recoil = get_val(PS4_RY) + active_recoil;

			if (final_recoil > 100) {
				final_recoil = 100;
			}

			if (final_recoil < -100) {
				final_recoil = -100;
			}

			set_val(PS4_RY, final_recoil);
		}
	}

	// 7. Headshot-Bias (FIX: keine lokale Deklaration mehr)
	if (hs_bias_enabled && get_val(PS4_L2) && !get_val(PS4_R2)) {
		hs_ry = get_val(PS4_RY);

		if (hs_ry > -50) {
			set_val(PS4_RY, hs_ry - hs_bias);
		}
	}

	// 8. Auto-Ping
	if (get_val(PS4_L2) && event_press(PS4_R2)) {
		combo_run(AutoPing);
	}

	// 9. Rotational Aim Assist
	if (get_val(PS4_L2)) {
		aa_power_current = (current_weapon == 0) ? aa_power : aa_power_ar;

		if (abs(get_val(PS4_RX)) < 30 && abs(get_val(PS4_RY)) < 30) {
			combo_run(SmoothRotationalAA);
		}
		else {
			combo_stop(SmoothRotationalAA);
		}

		if (abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
			combo_run(LeftStickRotational);
		}
		else {
			combo_stop(LeftStickRotational);
		}
	}
	else {
		combo_stop(SmoothRotationalAA);
		combo_stop(LeftStickRotational);
	}

	// 10. Strafe Aim
	if (strafe_aa_enabled && get_val(PS4_L2) && get_val(PS4_R2)) {
		combo_run(StrafeAim);
	}
	else {
		combo_stop(StrafeAim);
	}

	// 11. Snap Aim
	if (event_press(PS4_R3) && !get_val(PS4_L2) && abs(get_val(PS4_RX)) > 40) {
		combo_run(SnapAim);
	}

	// 12. Crouch on ADS
	if (crouch_on_ads_enabled && get_val(PS4_L2) && !get_val(PS4_R2)) {
		set_val(PS4_CIRCLE, 100);
	}

	// 13. Drop Shot
	if (dropshot_enabled && event_press(PS4_R2) && !get_val(PS4_L2) && !get_val(PS4_CIRCLE)) {
		combo_run(DropShot);
	}

	// 14. Slide + 3 Jump
	if (event_press(PS4_CIRCLE) && get_val(PS4_LY) < -60) {
		combo_run(SlideJumpChain);
	}

	// 15. Slide Cancel
	if (event_press(PS4_CIRCLE)) {
		if (get_rtime() - last_circle_time < 400) {
			combo_run(SlideCancel);
		}

		last_circle_time = get_rtime();
	}

	// 16. Bunny Hop
	if (get_val(PS4_L3) && get_val(PS4_LY) < -50) {
		combo_run(BunnyHop);
	}
	else {
		combo_stop(BunnyHop);
	}

	// 17. Auto Sprint
	if (autosprint_enabled && event_press(PS4_L3) && get_val(PS4_LY) < -70) {
		combo_run(AutoSprint);
	}

	// 18. Directional L2-Release Jump
	if (get_val(PS4_R2) && event_release(PS4_L2)) {
		if (get_val(PS4_LX) < -30) {
			jump_state = -100;
		}
		else if (get_val(PS4_LX) > 30) {
			jump_state = 100;
		}
		else {
			jump_state = -jump_state;
		}

		combo_run(DirectionalQuickJump);
	}
}

// ============================================================================
// FEEDBACK
// ============================================================================
function update_feedback() {
	cls_oled(0);

	if (current_weapon == 0) {
		set_led(LED_1, 1);
		set_led(LED_2, 0);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
		print(25, 8, 0, 1, "PROFIL: MP");
	}
	else {
		set_led(LED_1, 0);
		set_led(LED_2, 1);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
		print(25, 8, 0, 1, "PROFIL: AR");
	}

	print(0, 26, 0, 1, "V11 MOVEMENT EDITION");
	print(0, 40, 0, 1, "AA:");

	if (aa_power >= 6) {
		print(20, 40, 0, 1, ".");
	}

	if (aa_power >= 10) {
		print(26, 40, 0, 1, ".");
	}

	if (aa_power >= 14) {
		print(32, 40, 0, 1, ".");
	}

	if (aa_power >= 18) {
		print(38, 40, 0, 1, ".");
	}

	if (aa_power >= 22) {
		print(44, 40, 0, 1, ".");
	}

	if (aa_power >= 26) {
		print(50, 40, 0, 1, ".");
	}

	print(0, 54, 0, 1, "DROP/STRAFE/HS: ON");
}

// ============================================================================
// COMBOS
// ============================================================================
combo SlideJumpChain {
	set_val(PS4_CIRCLE, 100);
	wait(60);
	set_val(PS4_CIRCLE, 0);
	wait(50);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
	wait(100);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
	wait(100);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
}

combo SlideCancel {
	set_val(PS4_CIRCLE, 100);
	wait(45);
	set_val(PS4_CIRCLE, 0);
	wait(30);
	set_val(PS4_R3, 100);
	wait(35);
	set_val(PS4_R3, 0);
}

combo BunnyHop {
	set_val(PS4_R3, 100);
	wait(45);
	set_val(PS4_R3, 0);
	wait(bhop_delay);
}

combo AutoSprint {
	set_val(PS4_L3, 100);
	wait(30);
	set_val(PS4_L3, 0);
}

combo DropShot {
	set_val(PS4_CIRCLE, 100);
	wait(60);
	set_val(PS4_CIRCLE, 0);
	wait(80);
	set_val(PS4_CIRCLE, 100);
	wait(40);
	set_val(PS4_CIRCLE, 0);
}

combo StrafeAim {
	set_val(PS4_LX, get_val(PS4_LX) + strafe_power);
	wait(45);
	set_val(PS4_LX, get_val(PS4_LX) - strafe_power);
	wait(45);
}

combo SnapAim {
	set_val(PS4_RX, get_val(PS4_RX) + (get_val(PS4_RX) / 2));
	set_val(PS4_RY, get_val(PS4_RY) + (get_val(PS4_RY) / 2));
	wait(25);
	set_val(PS4_RX, get_val(PS4_RX));
	set_val(PS4_RY, get_val(PS4_RY));
}

combo SmoothRotationalAA {
	set_val(PS4_RY, get_val(PS4_RY) + aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) + aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) + aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX));
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) + aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) - aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY));
	set_val(PS4_RX, get_val(PS4_RX) - aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) - aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) - aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) - aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX));
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) - aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) + aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY));
	set_val(PS4_RX, get_val(PS4_RX) + aa_power_current);
	wait(aa_delay);
}

combo LeftStickRotational {
	set_val(PS4_LX, get_val(PS4_LX) + ls_power);
	wait(15);
	set_val(PS4_LX, get_val(PS4_LX) - ls_power);
	wait(15);
}

combo AutoPing {
	set_val(PS4_UP, 100);
	wait(15);
	set_val(PS4_UP, 0);
}

combo DirectionalQuickJump {
	set_val(PS4_LX, jump_state);
	set_val(PS4_R3, 100);
	wait(70);
	set_val(PS4_LX, jump_state);
	set_val(PS4_R3, 0);
}

combo YY_Spam {
	set_val(PS4_TRIANGLE, 100);
	wait(15);
	set_val(PS4_TRIANGLE, 0);
	wait(15);
	set_val(PS4_TRIANGLE, 100);
	wait(15);
	set_val(PS4_TRIANGLE, 0);
	wait(15);
}
