// ██║     ╚██████╗ ╚██████╗    ╚███╔███╔╝██║  ██║██║  ██║███████╗╚██████╔╝██║ ╚████║███████╗
// ╚═╝      ╚═════╝  ╚═════╝     ╚══╝╚══╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚══════╝
//
// PS5 WARZONE PRO SCRIPT - "STICK & MOVE" LAYOUT
// Version: 1.1 OPTIMIZED (GPC FIXED)
//
//============================================================================
//---------------------------/ USER CONFIG -----------------------------------
//--- SLIDE CANCEL JUMP (R3) ---
define SCJ_ENABLED = TRUE;
define SCJ_TRIGGER = 5;
define SCJ_SLIDE_BTN = 18;
define SCJ_JUMP_BTN = 5;

define SCJ_BACK_PULL = 85;
define SCJ_BACK_MS = 35;
define SCJ_SLIDE_MS = 110;
define SCJ_GAP_MS = 25;
define SCJ_JUMP_MS = 100;
define SCJ_HARD_MS = 70;

//--- AUTO SLIDE-BACK BEI L2-RELEASE ---
define ADS_RELEASE_SLIDE = TRUE;
define ADS_RELEASE_MAX = 250;
define ADS_FIRE_MIN = 60;

//--- AUTO HOLD BREATH ---
define AUTO_BREATH = TRUE;
define BREATH_DELAY = 200;
define BREATH_HOLD = 100;

//--- MELEE 1:1 (wird nie manipuliert) ---
define MELEE_BTN = 19;

//--- COMBAT FEATURES ---
define AIM__INVERTED = FALSE;
define EASY__RUN = TRUE;
define EASY__DROP = TRUE;
define FAST_RELOAD = TRUE;

int ANTIRECOIL_V = 8;
int ANTIRECOIL_H = 1;

define STICKY__AIM = TRUE;
define AIM__CORRECT = TRUE;
define VIBRATION = 30;

define ADS_SENS = 95;
define GEN_SENS = 100;
define HIP_SENS = 100;
define ADS_FIRE_SENS = 95;

define KILL__STREAK__SW = 15;

//---------------------------/ END USER CONFIG ------------------------------
//---------------------------/ PS5 CONTROLS ---------------------------------
define HOME = 0;
define VIEW = 1;
define OPTIONS = 2;
define LETHAL = 3;
define FIRE = 4;
define PRONE = 5;
define TACTICAL = 6;
define ADS = 7;
define SPRINT = 8;
define RX = 9;
define RY = 10;
define LX = 11;
define LY = 12;
define UP = 13;
define DOWN = 14;
define LEFT = 15;
define RIGHT = 16;
define TRIANGLE = 17;
define CIRCLE = 18;
define CROSS = 19;
define SQUARE = 20;

define SW_WEAPON = 17;
define RELOAD = 20;
define MELEE = 18;
define JUMP = 19;

//---------------------------/ LED FARBEN -----------------------------------
define LED_OFF = 0;
define LED_GREEN = 1;
define LED_BLUE = 2;
define LED_PINK = 3;
define LED_RED = 4;
define LED_SKYBLUE = 5;
define LED_YELLOW = 6;
define LED_WHITE = 7;

data(0, 0, 0, 0, 0, 0, 2, 0, 2, 0, 0, 0, 0, 0, 0, 2,
     0, 2, 0, 0, 2, 0, 2, 0, 0, 2, 2, 0, 2, 2, 2, 2);

//---------------------------/ VARIABLES ------------------------------------
int hold_time = 35;
int rest_time = 5;
int PrimaryWeapon = TRUE;
int RF_KS = FALSE;
int R2F_K2S = FALSE;
int Secondary = FALSE;
int RATE_OF_FIRE;
int fire__mods_ON = TRUE;
int Fire_KS = FALSE;
int autofire = 1;
int hold_burst = 200;
int rest_burst = 50;
int rumble = 0;
int Script_onoff = FALSE;
int sens = 100;

int scj_lock = FALSE;
int ads_was_firing = FALSE;

int current_led = -1;
int target_led = 0; // Fix für GPC4003 (Variable auf Top-Level deklariert)

int aa_counter = 15; // Fix für GPC5128 (Eigener Random-Counter)
int rand_aa = 20;

//---------------------------/ INIT -----------------------------------------
init {
	RATE_OF_FIRE = get_pvar(SPVAR_1, 1, 25, 12);
	update_rof_math();
}

//---------------------------/ MAIN BLOCK -----------------------------------
main {
	set_val(TRACE_1, RATE_OF_FIRE);
	// Rollierender Pseudo-Random Counter (15-29) für Sticky Aim
	aa_counter = aa_counter + 1;

	if (aa_counter > 29) {
		aa_counter = 15;
	}

	//====================================================================
	// SCRIPT ON / OFF
	//====================================================================
	if (get_val(DOWN) && event_press(SW_WEAPON)) {
		Script_onoff = !Script_onoff;
	}

	if (get_val(DOWN)) {
		set_val(SW_WEAPON, 0);
	}

	//================================================================
	// LED STATUS UPDATE
	//================================================================
	PLAY__LEDS();

	if (!Script_onoff) {
		//================================================================
		// AUTO HOLD BREATH (SNIPER)
		//================================================================
		if (AUTO_BREATH && get_val(ADS) && get_ptime(ADS) > BREATH_DELAY) {
			set_val(SPRINT, BREATH_HOLD);
		}

		//================================================================
		// AUTO SLIDE-BACK BEI L2-RELEASE
		//================================================================
		if (get_val(ADS) && get_val(FIRE) && get_ptime(FIRE) > ADS_FIRE_MIN) {
			ads_was_firing = TRUE;
		}

		if (event_release(ADS)) {
			if (ADS_RELEASE_SLIDE && ads_was_firing && get_ptime(ADS) < ADS_RELEASE_MAX && !scj_lock && !combo_running(SLIDE_BACK_JUMP)) {
				scj_lock = TRUE;
				combo_run(SLIDE_BACK_JUMP);
			}

			ads_was_firing = FALSE;
		}

		//================================================================
		// MENÜ-BEREICH (ADS + CIRCLE)
		//================================================================
		if (get_val(ADS) && !get_val(MELEE)) {
			if (get_val(VIEW) && get_ptime(VIEW) > 600) {
				RESET_Defaults();
			}

			if (event_press(TACTICAL)) {
				rumble = 2;
			}

			if (event_press(UP)) {
				PrimaryWeapon = TRUE;
				RF_KS = FALSE;
				R2F_K2S = TRUE;
				Secondary = TRUE;
				Fire_KS = FALSE;
				rumble = 2;
			}

			if (event_press(DOWN)) {
				PrimaryWeapon = TRUE;
				RF_KS = FALSE;
				R2F_K2S = FALSE;
				Secondary = FALSE;
				Fire_KS = FALSE;
				rumble = 2;
			}

			if (event_release(RIGHT)) {
				PrimaryWeapon = TRUE;
				RF_KS = TRUE;
				R2F_K2S = TRUE;
				Secondary = FALSE;
				Fire_KS = TRUE;
				rumble = 2;
			}

			if (get_val(RIGHT)) {
				if (event_release(VIEW)) {
					autofire = 1;
				}
				else if (event_release(OPTIONS)) {
					autofire = 2;
				}
			}

			set_val(VIEW, 0);
			set_val(OPTIONS, 0);
		}

		//================================================================
		// TOGGLES (DOWN + ADS)
		//================================================================
		if (get_val(DOWN) && get_val(ADS)) {
			if (event_press(FIRE)) {
				rumble = 2;
			}

			if (event_press(RELOAD)) {
				rumble = 2;
			}

			set_val(DOWN, 0);
			set_val(RELOAD, 0);
			set_val(JUMP, 0);
			set_val(MELEE, 0);
			set_val(SW_WEAPON, 0);
		}

		//================================================================
		// RATE OF FIRE ANPASSEN
		//================================================================
		if (get_val(MELEE) && event_press(OPTIONS)) {
			RATE_OF_FIRE++;

			if (RATE_OF_FIRE > 25) {
				RATE_OF_FIRE = 25;
			}

			update_rof_math();
		}

		if (get_val(MELEE) && get_val(OPTIONS)) {
			set_val(OPTIONS, 0);
		}

		if (get_val(MELEE) && event_press(VIEW)) {
			RATE_OF_FIRE--;

			if (RATE_OF_FIRE < 1) {
				RATE_OF_FIRE = 1;
			}

			update_rof_math();
		}

		if (get_val(MELEE) && get_val(VIEW)) {
			set_val(VIEW, 0);
		}

		//================================================================
		// BURST STUFEN
		//================================================================
		if (get_val(MELEE) && !get_val(ADS)) {
			if (event_press(UP)) {
				hold_burst = 200;
			}
			else if (event_press(RIGHT)) {
				hold_burst = 300;
			}
			else if (event_press(DOWN)) {
				hold_burst = 400;
			}
			else if (event_press(LEFT)) {
				hold_burst = 600;
			}

			set_val(UP, 0);
			set_val(RIGHT, 0);
			set_val(DOWN, 0);
			set_val(LEFT, 0);
		}

		if (event_release(MELEE) && get_ptime(MELEE) > 600) {
			save_pvars();
		}

		//================================================================
		// EASY DROP SHOT
		//================================================================
		if (EASY__DROP) {
			if (event_release(PRONE) && get_ptime(PRONE) < 200) {
				combo_run(DROP_SHOT);
			}
		}

		//================================================================
		// R3: RÜCKWÄRTS SLIDE + HARD JUMP
		//================================================================
		if (SCJ_ENABLED && event_press(SCJ_TRIGGER) && !get_val(ADS) && !get_val(DOWN) && !scj_lock) {
			scj_lock = TRUE;
			combo_run(SLIDE_BACK_JUMP);
		}

		if (scj_lock && !combo_running(SLIDE_BACK_JUMP) && !get_val(SCJ_TRIGGER)) {
			scj_lock = FALSE;
		}

		if (scj_lock && get_ptime(SCJ_TRIGGER) > 1000) {
			scj_lock = FALSE;
		}

		if (SCJ_ENABLED && scj_lock && !combo_running(SLIDE_BACK_JUMP)) {
			set_val(SCJ_TRIGGER, 0);
		}

		//================================================================
		// ANTI-RECOIL
		//================================================================
		if (get_val(FIRE) && (RF_KS || R2F_K2S) && fire__mods_ON) {
			combo_run(ANTI_RECOIL);
		}
		else {
			combo_stop(ANTI_RECOIL);
		}

		//================================================================
		// AIM CORRECTION
		//================================================================
		if (AIM__CORRECT) {
			Aim__Correction();
		}

		//================================================================
		// EASY RUN
		//================================================================
		if (EASY__RUN && get_val(LY) < -5 && !get_val(ADS)) {
			combo_run(EASY_RUN);
		}

		//================================================================
		// RAPID FIRE / BURST FIRE
		//================================================================
		if (PrimaryWeapon && RF_KS && fire__mods_ON && get_val(FIRE)) {
			if (autofire == 1) {
				combo_run(RAPID_FIRE);
			}
			else if (autofire == 2) {
				combo_run(BURST_FIRE);
			}
		}

		if (!PrimaryWeapon && R2F_K2S && fire__mods_ON && get_val(FIRE)) {
			combo_run(RAPID_FIRE);
		}

		//================================================================
		// FAST RELOAD CANCEL
		//================================================================
		if (FAST_RELOAD) {
			if (get_val(RELOAD) && event_press(FIRE)) {
				combo_run(FAST_RELOAD_CANCEL);
			}
		}

		//================================================================
		// SECONDARY / WEAPON SWITCH
		//================================================================
		if (event_release(RELOAD) && get_ptime(RELOAD) > 200 && Secondary) {
			PrimaryWeapon = TRUE;
			rumble = 2;
		}

		if (Secondary) {
			if (event_release(SW_WEAPON) && get_ptime(SW_WEAPON) < 200 && !get_val(DOWN)) {
				PrimaryWeapon = !PrimaryWeapon;

				if (!PrimaryWeapon) {
					rumble = 2;
				}
			}
		}

		//================================================================
		// STICKY AIM
		//================================================================
		if (STICKY__AIM && get_val(ADS)) {
			combo_run(AA_XY);
		}
		else {
			combo_stop(AA_XY);
		}

		//================================================================
		// KILLSTREAK SWITCH
		//================================================================
		if (!get_val(MELEE)) {
			if (event_press(KILL__STREAK__SW) && !get_val(ADS) && get_ptime(KILL__STREAK__SW) < 15) {
				combo_run(KILL);
			}
		}

		//================================================================
		// RUMBLE
		//================================================================
		if (rumble > 0) {
			combo_run(RUMBLE);
		}
	}
}

//============================================================================
// COMBO SECTION
//============================================================================
combo SLIDE_BACK_JUMP {
	set_val(LY, SCJ_BACK_PULL);
	wait(SCJ_BACK_MS);
	set_val(SCJ_SLIDE_BTN, 100);
	wait(SCJ_SLIDE_MS);
	set_val(SCJ_SLIDE_BTN, 0);
	set_val(LY, 0);
	wait(SCJ_GAP_MS);
	set_val(SCJ_JUMP_BTN, 100);
	wait(SCJ_JUMP_MS);
	set_val(SCJ_JUMP_BTN, 0);
	wait(20);
	set_val(SCJ_JUMP_BTN, 100);
	wait(SCJ_HARD_MS);
	set_val(SCJ_JUMP_BTN, 0);
	wait(20);
}

combo FAST_RELOAD_CANCEL {
	wait(120);
	set_val(SW_WEAPON, 100);
	wait(40);
	set_val(SW_WEAPON, 0);
	wait(40);
	set_val(SW_WEAPON, 100);
	wait(40);
	set_val(SW_WEAPON, 0);
}

combo AA_XY {
	rand_aa = aa_counter; // Greift den rollierenden Wert ab
	set_val(RY, xy_val(RY, rand_aa));
	wait(20);
	set_val(RX, xy_val(RX, rand_aa));
	set_val(LX, xy_val(LX, rand_aa));
	wait(20);
	set_val(RY, xy_val(RY, rand_aa * -1));
	wait(20);
	set_val(RX, xy_val(RX, rand_aa * -1));
	set_val(LX, xy_val(LX, rand_aa * -1));
	wait(20);
}

combo ANTI_RECOIL {
	if (abs(get_val(RY)) < 25) {
		if (AIM__INVERTED) {
			set_val(RY, get_val(RY) + ANTIRECOIL_V);
		}
		else {
			set_val(RY, get_val(RY) - ANTIRECOIL_V);
		}
	}

	wait(20);

	if (abs(get_val(RX)) < 25) {
		set_val(RX, get_val(RX) + ANTIRECOIL_H);
	}

	wait(20);
}

combo RUMBLE {
	set_rumble(RUMBLE_B, 100);
	wait(150);
	reset_rumble();
	wait(150);
	rumble--;
}

combo RAPID_FIRE {
	set_val(FIRE, 100);
	wait(hold_time);
	set_val(FIRE, 0);
	wait(rest_time);
}

combo BURST_FIRE {
	set_val(FIRE, 100);
	wait(hold_burst);
	set_val(FIRE, 0);
	wait(rest_burst);
	set_val(FIRE, 0);
}

combo KILL {
	if (Fire_KS) {
		combo_run(NO__FIRE_MOD);
	}

	wait(40);
	set_val(SW_WEAPON, 100);
	wait(400);
	set_val(SW_WEAPON, 0);
	wait(40);
}

combo NO__FIRE_MOD {
	fire__mods_ON = FALSE;
	combo_run(BLINK_AR);
	wait(30000);
	fire__mods_ON = TRUE;
	combo_stop(BLINK_AR);
}

combo DROP_SHOT {
	set_val(PRONE, 100);
	wait(900);
}

combo BLINK_AR {
	wait(350);
	set_rumble(RUMBLE_B, VIBRATION);
	current_led = LED_OFF;
	color_led(LED_OFF);
	wait(100);
	reset_leds();
	reset_rumble();
}

combo EASY_RUN {
	set_val(SPRINT, 100);
	wait(30);
}

//============================================================================
// FUNCTIONS
//============================================================================
function update_rof_math() {
	hold_time = 500 / RATE_OF_FIRE;

	if (hold_time < 15) {
		hold_time = 15;
	}

	rest_time = hold_time / 4;

	if (rest_time < 3) {
		rest_time = 3;
	}

	if (rest_time > 20) {
		rest_time = 20;
	}
}

function RESET_Defaults() {
	RATE_OF_FIRE = 15;
	ANTIRECOIL_V = 8;
	update_rof_math();
	rumble = 2;
}

function save_pvars() {
	set_pvar(SPVAR_1, RATE_OF_FIRE);
	rumble = 2;
}

function Aim__Correction() {
	if (get_val(FIRE) && get_val(ADS)) {
		sens = ADS_FIRE_SENS;
	}
	else if (get_val(FIRE)) {
		sens = HIP_SENS;
	}
	else if (get_val(ADS)) {
		sens = ADS_SENS;
	}
	else {
		sens = GEN_SENS;
	}

	sensitivity(RX, NOT_USE, sens);
	sensitivity(RY, NOT_USE, sens);
}

function xy_val(f_axis, f_val) {
	if (abs(get_val(f_axis)) < 25) {
		return f_val;
	}

	return get_val(f_axis);
}

function PLAY__LEDS() {
	target_led = LED_OFF; // Greift jetzt auf die globale Variable zu

	if (Script_onoff) {
		target_led = LED_OFF;
	}
	else {
		if (PrimaryWeapon && RF_KS && autofire == 1) {
			target_led = LED_WHITE;
		}
		else if (PrimaryWeapon && RF_KS && autofire == 2) {
			target_led = LED_YELLOW;
		}
		else if (!PrimaryWeapon && R2F_K2S) {
			target_led = LED_RED;
		}
		else if (STICKY__AIM && get_val(ADS)) {
			target_led = LED_PINK;
		}
		else if (RATE_OF_FIRE < 2 || RATE_OF_FIRE > 24) {
			target_led = LED_RED;
		}
		else if (AUTO_BREATH && get_val(ADS)) {
			target_led = LED_GREEN;
		}
	}

	if (target_led != current_led) {
		color_led(target_led);
		current_led = target_led;
	}
}

function color_led(colour) {
	set_led(LED_1, duint8(colour * 4));
	set_led(LED_2, duint8((colour * 4) + 1));
	set_led(LED_3, duint8((colour * 4) + 2));
	set_led(LED_4, duint8((colour * 4) + 3));
}
