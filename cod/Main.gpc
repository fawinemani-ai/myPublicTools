// ============================================================================
// 🎮 WARZONE GPC PRO | V12.1 - ALL-IN-ONE EDITION
// ============================================================================
// Alle Features permanent aktiv, ein Profil
// ============================================================================
// ----------------------------------------------------------------------------
// KONFIGURATION
// ----------------------------------------------------------------------------
int RECOIL_ADS_DELAY = 50;
int RECOIL_DECAY_MS = 200;
int AA_RAMP_MS = 180;
int MAX_AA = 32;
int MIN_AA = 4;

// Anti-Recoil
int cur_rv = 16; // Vertikal Startwert
int cur_rv_max = 34; // Vertikal Max
int cur_rh = 2; // Horizontal
int cur_rcr = 6; // Curve Rate

// Aim Assist
int aa_base = 14;
int aa_bias = 0;
int aa_delay = 18;
int ls_power = 12;
int hs_bias = 3;

// Movement
int strafe_power = 8;
int bhop_delay = 130;

// Laufzeit
int active_recoil = 0;
int final_recoil = 0;
int recoil_elapsed = 0;
int recoil_curve_bonus = 0;
int aa_power_current = 0;
int last_circle_time = 0;
int jump_state = 100;
int last_recoil_active = 0;
int recoil_decay_t = 0;
int tmp_pct = 0;
int tmp_decay = 0;
int ads_time = 0;
int ramp = 0;
int hs_ry = 0;
int rnd_seed = 0;

// ============================================================================
// INIT
// ============================================================================
init {
	update_feedback();
}

// ============================================================================
// MAIN
// ============================================================================
main {
	// -------- 1. Hair Triggers --------
	if (get_val(PS4_L2) > 5) {
		set_val(PS4_L2, 100);
	}

	if (get_val(PS4_R2) > 5) {
		set_val(PS4_R2, 100);
	}

	// -------- 2. AA-Bias Tuning --------
	if (get_val(PS4_L2)) {
		if (event_press(PS4_R3)) {
			aa_bias = aa_bias + 2;

			if (aa_bias > 18) {
				aa_bias = 18;
			}

			update_feedback();
		}

		if (event_press(PS4_L1)) {
			aa_bias = aa_bias - 2;

			if (aa_bias < -10) {
				aa_bias = -10;
			}

			update_feedback();
		}
	}

	// -------- 3. Reset --------
	if (get_val(PS4_TOUCH) && event_press(PS4_TRIANGLE)) {
		aa_bias = 0;
		update_feedback();
	}

	// -------- 4. Y-Y Spam --------
	if (get_val(PS4_RIGHT)) {
		combo_run(YY_Spam);
	}
	else if (combo_running(YY_Spam)) {
		combo_stop(YY_Spam);
	}

	// -------- 5. Anti-Recoil --------
	if (get_val(PS4_L2) && get_val(PS4_R2) && get_ptime(PS4_R2) > RECOIL_ADS_DELAY) {
		last_recoil_active = 1;
		recoil_decay_t = 0;
		recoil_elapsed = get_ptime(PS4_R2);
		recoil_curve_bonus = (recoil_elapsed * recoil_elapsed) / 3000;

		if (recoil_curve_bonus > 15) {
			recoil_curve_bonus = 15;
		}

		active_recoil = cur_rv + (recoil_elapsed / 100) * cur_rcr + recoil_curve_bonus;

		if (active_recoil > cur_rv_max) {
			active_recoil = cur_rv_max;
		}

		if (abs(get_val(PS4_RY)) < 40 && abs(get_val(PS4_RX)) < 40) {
			final_recoil = get_val(PS4_RY) + active_recoil;

			if (final_recoil > 100) {
				final_recoil = 100;
			}

			if (final_recoil < -100) {
				final_recoil = -100;
			}

			set_val(PS4_RY, final_recoil);

			// Horizontaler Recoil
			if (cur_rh > 0) {
				rnd_seed = (rnd_seed + 7) % 100;

				if (rnd_seed > 50) {
					set_val(PS4_RX, get_val(PS4_RX) + cur_rh);
				}
				else {
					set_val(PS4_RX, get_val(PS4_RX) - cur_rh);
				}
			}
		}
	}
	else if (last_recoil_active) {
		recoil_decay_t = recoil_decay_t + 20;

		if (recoil_decay_t >= RECOIL_DECAY_MS) {
			last_recoil_active = 0;
			recoil_decay_t = 0;
		}
		else {
			tmp_pct = 100 - ((recoil_decay_t * 100) / RECOIL_DECAY_MS);
			tmp_decay = (active_recoil * tmp_pct) / 100;

			if (tmp_decay > 0) {
				set_val(PS4_RY, get_val(PS4_RY) + tmp_decay);
			}
		}
	}
	else {
		last_recoil_active = 0;
	}

	// -------- 6. Headshot-Bias --------
	if (get_val(PS4_L2) && !get_val(PS4_R2)) {
		hs_ry = get_val(PS4_RY);

		if (hs_ry > -50) {
			set_val(PS4_RY, hs_ry - hs_bias);
		}
	}

	// -------- 7. Auto-Ping --------
	if (get_val(PS4_L2) && event_press(PS4_R2)) {
		combo_run(AutoPing);
	}

	// -------- 8. Rapid Fire (L2 + DPAD-Down zum schnellen An/Aus) --------
	if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
		combo_run(RapidFire);
	}

	// -------- 9. Rotational AA mit Ramp --------
	if (get_val(PS4_L2)) {
		ads_time = get_ptime(PS4_L2);
		ramp = 100;

		if (ads_time < AA_RAMP_MS) {
			ramp = (ads_time * 100) / AA_RAMP_MS;
		}

		aa_power_current = aa_base + aa_bias;

		if (aa_power_current < MIN_AA) {
			aa_power_current = MIN_AA;
		}

		if (aa_power_current > MAX_AA) {
			aa_power_current = MAX_AA;
		}

		aa_power_current = (aa_power_current * ramp) / 100;

		if (abs(get_val(PS4_RX)) < 30 && abs(get_val(PS4_RY)) < 30) {
			combo_run(SmoothRotationalAA);
		}
		else {
			combo_stop(SmoothRotationalAA);
		}

		if (abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
			combo_run(LeftStickRotational);
		}
		else {
			combo_stop(LeftStickRotational);
		}
	}
	else {
		combo_stop(SmoothRotationalAA);
		combo_stop(LeftStickRotational);
	}

	// -------- 10. Strafe Aim --------
	if (get_val(PS4_L2) && get_val(PS4_R2)) {
		combo_run(StrafeAim);
	}
	else {
		combo_stop(StrafeAim);
	}

	// -------- 11. Snap Aim --------
	if (event_press(PS4_R3) && !get_val(PS4_L2) && abs(get_val(PS4_RX)) > 40) {
		combo_run(SnapAim);
	}

	// -------- 12. Drop Shot --------
	if (event_press(PS4_R2) && !get_val(PS4_L2) && !get_val(PS4_CIRCLE)) {
		combo_run(DropShot);
	}

	// -------- 13. Slide + 3 Jump --------
	if (event_press(PS4_CIRCLE) && get_val(PS4_LY) < -60) {
		combo_run(SlideJumpChain);
	}

	// -------- 14. Slide Cancel --------
	if (event_press(PS4_CIRCLE)) {
		if (get_rtime() - last_circle_time < 400) {
			combo_run(SlideCancel);
		}

		last_circle_time = get_rtime();
	}

	// -------- 15. Bunny Hop --------
	if (get_val(PS4_L3) && get_val(PS4_LY) < -50) {
		if ((get_rtime() % 4) < 2) {
			bhop_delay = 128;
		}
		else {
			bhop_delay = 134;
		}

		combo_run(BunnyHop);
	}
	else {
		combo_stop(BunnyHop);
	}

	// -------- 16. Auto Sprint --------
	if (event_press(PS4_L3) && get_val(PS4_LY) < -70) {
		combo_run(AutoSprint);
	}

	// -------- 17. Directional L2-Release Jump --------
	if (get_val(PS4_R2) && event_release(PS4_L2)) {
		if (get_val(PS4_LX) < -30) {
			jump_state = -100;
		}
		else if (get_val(PS4_LX) > 30) {
			jump_state = 100;
		}
		else {
			jump_state = -jump_state;
		}

		combo_run(DirectionalQuickJump);
	}
}

// ============================================================================
// FEEDBACK
// ============================================================================
function update_feedback() {
	cls_oled(0);
	set_led(LED_1, 1);
	set_led(LED_2, 1);
	set_led(LED_3, 1);
	set_led(LED_4, 1);
	print(0, 8, 0, 1, "WARZONE V12.1");
	print(0, 22, 0, 1, "ALL-IN-ONE");
	print(0, 38, 0, 1, "AA:");

	if (aa_bias >= -10) {
		print(24, 38, 0, 1, ".");
	}

	if (aa_bias >= -6) {
		print(30, 38, 0, 1, ".");
	}

	if (aa_bias >= -2) {
		print(36, 38, 0, 1, ".");
	}

	if (aa_bias >= 2) {
		print(42, 38, 0, 1, ".");
	}

	if (aa_bias >= 6) {
		print(48, 38, 0, 1, ".");
	}

	if (aa_bias >= 10) {
		print(54, 38, 0, 1, ".");
	}

	if (aa_bias >= 14) {
		print(60, 38, 0, 1, ".");
	}

	print(0, 54, 0, 1, "ALL FEATURES: ON");
}

// ============================================================================
// COMBOS
// ============================================================================
combo SlideJumpChain {
	set_val(PS4_CIRCLE, 100);
	wait(60);
	set_val(PS4_CIRCLE, 0);
	wait(50);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
	wait(100);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
	wait(100);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
}

combo SlideCancel {
	set_val(PS4_CIRCLE, 100);
	wait(45);
	set_val(PS4_CIRCLE, 0);
	wait(30);
	set_val(PS4_R3, 100);
	wait(35);
	set_val(PS4_R3, 0);
}

combo BunnyHop {
	set_val(PS4_R3, 100);
	wait(45);
	set_val(PS4_R3, 0);
	wait(bhop_delay);
}

combo AutoSprint {
	set_val(PS4_L3, 100);
	wait(30);
	set_val(PS4_L3, 0);
}

combo DropShot {
	set_val(PS4_CIRCLE, 100);
	wait(60);
	set_val(PS4_CIRCLE, 0);
	wait(80);
	set_val(PS4_CIRCLE, 100);
	wait(40);
	set_val(PS4_CIRCLE, 0);
}

combo StrafeAim {
	set_val(PS4_LX, get_val(PS4_LX) + strafe_power);
	wait(45);
	set_val(PS4_LX, get_val(PS4_LX) - strafe_power);
	wait(45);
}

combo SnapAim {
	set_val(PS4_RX, get_val(PS4_RX) + (get_val(PS4_RX) / 2));
	set_val(PS4_RY, get_val(PS4_RY) + (get_val(PS4_RY) / 2));
	wait(25);
	set_val(PS4_RX, get_val(PS4_RX));
	set_val(PS4_RY, get_val(PS4_RY));
}

combo SmoothRotationalAA {
	set_val(PS4_RY, get_val(PS4_RY) + aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) + aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) + aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX));
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) + aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) - aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY));
	set_val(PS4_RX, get_val(PS4_RX) - aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) - aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) - aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) - aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX));
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY) - aa_power_current);
	set_val(PS4_RX, get_val(PS4_RX) + aa_power_current);
	wait(aa_delay);
	set_val(PS4_RY, get_val(PS4_RY));
	set_val(PS4_RX, get_val(PS4_RX) + aa_power_current);
	wait(aa_delay);
}

combo LeftStickRotational {
	set_val(PS4_LX, get_val(PS4_LX) + ls_power);
	wait(15);
	set_val(PS4_LX, get_val(PS4_LX) - ls_power);
	wait(15);
}

combo AutoPing {
	set_val(PS4_UP, 100);
	wait(15);
	set_val(PS4_UP, 0);
}

combo DirectionalQuickJump {
	set_val(PS4_LX, jump_state);
	set_val(PS4_R3, 100);
	wait(70);
	set_val(PS4_LX, jump_state);
	set_val(PS4_R3, 0);
}

combo RapidFire {
	set_val(PS4_R2, 100);
	wait(35);
	set_val(PS4_R2, 0);
	wait(35);
}

combo YY_Spam {
	set_val(PS4_TRIANGLE, 100);
	wait(15);
	set_val(PS4_TRIANGLE, 0);
	wait(15);
	set_val(PS4_TRIANGLE, 100);
	wait(15);
	set_val(PS4_TRIANGLE, 0);
	wait(15);
}
